# Frontend Supabase Configuration (Publishable Anon Key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-publishable-anon-key-here

# Backend / Serverless Supabase & Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-secret-key-here

# Strong JWT Secret (Generate using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=generate-a-strong-64-char-random-secret-in-production

# CORS Allowed Origins (Comma separated)
ALLOWED_ORIGINS=https://core-team-web-site.vercel.app,http://localhost:5173,http://localhost:3000

# API URL (Leave blank for same-origin on Vercel and local Vite dev server)
VITE_API_URL=
